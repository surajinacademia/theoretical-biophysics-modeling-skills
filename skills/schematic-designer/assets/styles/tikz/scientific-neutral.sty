\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{scientific-neutral}[2026/08/12 schematic-designer neutral styles]

\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{iftex}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{pgfplots}

\RequirePackage{minimalist-profile}

\pgfplotsset{compat=1.18}

\usetikzlibrary{
  angles,
  arrows.meta,
  backgrounds,
  calc,
  decorations.pathmorphing,
  decorations.pathreplacing,
  fit,
  intersections,
  patterns,
  positioning,
  quotes,
  shapes.geometric
}

\usepgfplotslibrary{groupplots}

\AtBeginDocument{\sffamily}

\pgfplotsset{
  every axis/.append style={
    label style={font=\sffamily},
    tick label style={font=\sffamily},
    legend style={font=\sffamily}
  }
}

\colorlet{saBlue}{msColor5}
\colorlet{saCyan}{msColor6}
\colorlet{saGreen}{msColor4}
\colorlet{saAmber}{msColor2}
\colorlet{saRed}{msColor1}
\colorlet{saViolet}{msColor6}
\colorlet{saInk}{msInk}
\colorlet{saGray}{msMuted}
\colorlet{saLightGray}{msGrid}
\colorlet{saPanelGray}{msPaper}

\newlength{\saCellWidth}
\newlength{\saCellHeight}
\newlength{\saProcessBoxWidth}
\newlength{\saProcessBoxHeight}
\newlength{\saChipWidth}
\newlength{\saChipHeight}
\newlength{\saZoneWidth}
\newlength{\saZoneHeight}

\setlength{\saCellWidth}{1.20cm}
\setlength{\saCellHeight}{0.82cm}
\setlength{\saProcessBoxWidth}{1.42cm}
\setlength{\saProcessBoxHeight}{0.50cm}
\setlength{\saChipWidth}{0.52cm}
\setlength{\saChipHeight}{0.34cm}
\setlength{\saZoneWidth}{1.45cm}
\setlength{\saZoneHeight}{2.55cm}

\newcommand{\saFontPanelLabel}{\sffamily\bfseries\fontsize{\msFontPanel}{12pt}\selectfont}
\newcommand{\saFontTitle}{\sffamily\bfseries\fontsize{\msFontTitle}{10.8pt}\selectfont}
\newcommand{\saFontBody}{\sffamily\fontsize{\msFontBody}{9.6pt}\selectfont}
\newcommand{\saFontSmall}{\sffamily\fontsize{\msFontSmall}{8.4pt}\selectfont}
\newcommand{\saFontTiny}{\sffamily\fontsize{\msFontSmall}{8.4pt}\selectfont}
\newcommand{\saFontEquation}{\sffamily\fontsize{\msFontEquation}{9.6pt}\selectfont}

\tikzset{
  every picture/.append style={ms base,font=\saFontBody},
  every node/.append style={font=\saFontBody},
  sa/font panel label/.style={font=\saFontPanelLabel},
  sa/font title/.style={font=\saFontTitle},
  sa/font body/.style={font=\saFontBody},
  sa/font small/.style={font=\saFontSmall},
  sa/font tiny/.style={font=\saFontTiny},
  sa/font equation/.style={font=\saFontEquation},
  sa/panel/.style={
    draw=none,
    fill=none,
    rounded corners=0pt,
    line width=\msLineContext
  },
  sa/panel label/.style={
    sa/font panel label,
    text=saInk,
    anchor=north west
  },
  sa/cell/.style={
    ellipse,
    draw=saBlue,
    fill=saCyan,fill opacity=\msOpacityFill,text opacity=1,
    line width=\msLineStructure,
    minimum width=\saCellWidth,
    minimum height=\saCellHeight,
    align=center,
    inner sep=\msSpaceLabel
  },
  sa/source cell/.style={
    ellipse,
    draw=saAmber,
    fill=saAmber,fill opacity=\msOpacityFill,text opacity=1,
    line width=\msLineStructure,
    minimum width=\saCellWidth,
    minimum height=\saCellHeight,
    align=center,
    inner sep=\msSpaceLabel
  },
  sa/nucleus/.style={
    circle,
    draw=saBlue,
    fill=saBlue,fill opacity=\msOpacityFill,text opacity=1,
    minimum size=4mm,
    inner sep=0pt
  },
  sa/receptor/.style={
    draw=saRed,
    fill=saRed,fill opacity=\msOpacityFill,text opacity=1,
    rounded corners=0.8pt,
    minimum width=2.8mm,
    minimum height=1.2mm,
    inner sep=0pt
  },
  sa/matrix node/.style={
    circle,
    draw=saInk,
    fill=white,
    line width=\msLineContext,
    minimum size=2.4mm,
    inner sep=0pt
  },
  sa/fiber/.style={
    draw=saGray,
    line width=\msLineStructure,
    line cap=butt
  },
  sa/active fiber/.style={
    sa/fiber,
    draw=saGreen,
    line width=\msLineEmphasis
  },
  sa/buckled fiber/.style={
    sa/fiber,
    decorate,
    decoration={snake, amplitude=0.35mm, segment length=2.2mm}
  },
  sa/force arrow/.style={
    -{Latex[length=\msArrowLength,width=\msArrowWidth]},
    draw=saRed,
    line width=\msLineStructure,
    line cap=butt
  },
  sa/tension arrow/.style={
    {Latex[length=\msArrowLength,width=\msArrowWidth]}-{Latex[length=\msArrowLength,width=\msArrowWidth]},
    draw=saAmber,
    line width=\msLineStructure,
    line cap=butt
  },
  sa/displacement arrow/.style={
    -{Latex[length=\msArrowLength,width=\msArrowWidth]},
    draw=saGreen,
    line width=\msLineStructure,
    dash pattern=on \msDashDashedOn off \msDashDashedOff
  },
  sa/gradient arrow/.style={
    -{Latex[length=\msArrowLength,width=\msArrowWidth]},
    draw=saAmber,
    line width=\msLineStructure
  },
  sa/torque arrow/.style={
    -{Latex[length=\msArrowLength,width=\msArrowWidth]},
    draw=saViolet,
    line width=\msLineStructure
  },
  sa/sensing radius/.style={
    draw=saBlue,draw opacity=\msOpacityContext,
    dash pattern=on \msDashDashedOn off \msDashDashedOff,
    line width=\msLineStructure,
    draw opacity=\msOpacityContext,fill opacity=\msOpacityFill,text opacity=1
  },
  sa/annotation/.style={
    draw=saGray,draw opacity=\msOpacityContext,
    fill=white,
    rounded corners=2pt,
    inner xsep=\msSpaceLabel,
    inner ysep=\msSpaceLabel,
    align=center
  },
  sa/process box/.style={
    sa/annotation,
    minimum width=\saProcessBoxWidth,
    minimum height=\saProcessBoxHeight,
    text width=\saProcessBoxWidth,
    inner xsep=\msSpaceLabel,
    inner ysep=\msSpaceLabel,
    sa/font small,
    align=center
  },
  sa/annotation chip/.style={
    sa/annotation,
    minimum width=\saChipWidth,
    minimum height=\saChipHeight,
    inner xsep=\msSpaceLabel,
    inner ysep=\msSpaceLabel,
    sa/font tiny,
    align=center
  },
  sa/layout zone/.style={
    inner sep=0pt,
    outer sep=0pt,
    minimum width=\saZoneWidth,
    minimum height=\saZoneHeight,
    draw=none,
    fill=none
  },
  sa/layout zone debug/.style={
    sa/layout zone,
    draw=saLightGray,
    fill=white,
    draw opacity=\msOpacityContext,fill opacity=\msOpacityFill,text opacity=1,
    rounded corners=2pt
  },
  sa/annotation arrow/.style={
    -{Latex[length=\msArrowLength,width=\msArrowWidth]},
    draw=saInk,
    line width=\msLineStructure,
    line cap=butt
  },
  sa/imported plot/.style={
    inner sep=0pt,
    outer sep=0pt,
    anchor=south west
  },
  sa/plot frame/.style={
    draw=saLightGray,
    fill=none,
    rounded corners=2pt,
    line width=\msLineContext
  },
  sa/equation box/.style={
    draw=saGray,draw opacity=\msOpacityContext,
    fill=white,
    rounded corners=3pt,
    inner xsep=\msSpaceLabel,
    inner ysep=\msSpaceLabel,
    sa/font equation,
    align=center
  },
  sa/scale bar/.style={
    draw=saInk,
    line width=\msLineStructure
  },
  sa/axis/.style={
    axis line style={draw=saInk},
    tick style={draw=saInk},
    label style={text=saInk},
    tick label style={text=saInk},
    grid=none,
    grid style={draw=saLightGray},
    legend style={
      draw=none,
      fill=none
    }
  }
}

\newcommand{\sapanelLabel}[2]{%
  \node[sa/panel label] at #1 {#2};%
}

\newcommand{\sascaleBar}[3]{%
  \draw[sa/scale bar] #1 -- ++(#2,0)
    node[midway, below=\msSpaceLabel] {#3};%
}
