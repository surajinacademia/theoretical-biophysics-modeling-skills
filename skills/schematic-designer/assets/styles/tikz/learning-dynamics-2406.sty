\tikzset{
  every node/.append style={font=\sffamily,text=Ink},
  majorheading/.style={font=\sffamily\bfseries\fontsize{13}{15}\selectfont},
  sectiontitle/.style={font=\sffamily\bfseries\fontsize{10.5}{12}\selectfont},
  paneltag/.style={font=\sffamily\bfseries\fontsize{11.5}{12.5}\selectfont},
  paneltitle/.style={font=\sffamily\bfseries\fontsize{9.5}{11}\selectfont},
  annotation/.style={font=\sffamily\fontsize{8}{9.5}\selectfont},
  boldannotation/.style={font=\sffamily\bfseries\fontsize{8}{9.5}\selectfont},
  mathlabel/.style={font=\fontsize{9}{10.5}\selectfont},
  ticklabel/.style={font=\sffamily\fontsize{7.5}{9}\selectfont},
  entityi/.style={circle,draw=EntityPurpleEdge,fill=EntityPurple,
                  line width=1.1pt,minimum size=6.6mm,inner sep=0pt},
  entityj/.style={circle,draw=EntityOrangeEdge,fill=EntityOrange,
                  line width=1.1pt,minimum size=6.6mm,inner sep=0pt},
  trainarrow/.style={-{Latex[length=2.5mm,width=1.7mm]},draw=Train,
                     line width=1.6pt},
  retrievearrow/.style={-{Latex[length=2.8mm,width=1.9mm]},draw=Retrieve,
                        line width=1.8pt},
  positive/.style={draw=InteractionBlue,line width=1.45pt},
  negative/.style={draw=InteractionRed,line width=1.45pt,dashed},
  axisline/.style={draw=Ink,line width=0.85pt},
  snapshot/.style={draw=Ink,line width=0.85pt},
  processarrow/.style={-{Latex[length=2.5mm,width=1.7mm]},line width=1.55pt},
  thinprocess/.style={-{Latex[length=2.1mm,width=1.4mm]},line width=1.2pt}
}
